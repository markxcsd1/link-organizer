# ── Required ──────────────────────────────────────────────────────────────────

# Any random string protecting the internal endpoints (e.g. openssl rand -hex 32)
SECRET_KEY=your_secret_key_here

# Groq (free tier) — get a key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Notion integration token + the "To Play" database id (share the DB with the integration)
NOTION_API_KEY=your_notion_integration_token_here
NOTION_DB_GAME=your_to_play_database_id

# Telegram bot token (from @BotFather) + your numeric user id (the only authorised user)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_USER_ID=your_numeric_telegram_user_id

# ── Optional (the bot degrades gracefully without these) ─────────────────────

# IGDB, via a free Twitch app (dev.twitch.tv) — enriches console platforms + non-Steam games
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Jina Reader (jina.ai/reader) — renders JS-heavy store/social pages. Works with no key;
# a free key raises the rate limit (20 -> 500 req/min).
JINA_API_KEY=

# Groq model overrides — set if Groq deprecates the defaults (no code deploy needed).
# Current models: console.groq.com/docs/models
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_CHAT=openai/gpt-oss-120b
